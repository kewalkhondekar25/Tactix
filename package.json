{
  "name": "tactix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "webhook": "cd ./apps/webhook && bun run --hot src/index.ts",
    "sweeper": "cd ./apps/sweeper && bun run --hot index.ts",
    "worker": "cd ./apps/worker && bun run --hot src/index.ts" 
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
